# Manufacturing Dealer Sourcing Automation System - Environment Variables
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Excel Storage Configuration
EXCEL_FILE_PATH=data/Dealer_Sourcing_Tracker.xlsx
BACKUP_DIR=data/backups
QUOTATIONS_DIR=quotations

# Max upload file size in bytes (10MB)
MAX_UPLOAD_SIZE=10485760

# Optional Supplier Portal API Keys (Authorized Integrations)
THOMASNET_API_KEY=
INDIAMART_API_KEY=
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# Vision AI Configuration (for Image-based Product Sourcing)
# Configure one of the keys below to enable cloud Vision AI image analysis:
# - Google Gemini Vision AI (Recommended): https://aistudio.google.com/
GEMINI_API_KEY=
# - OpenAI Vision AI (GPT-4o): https://platform.openai.com/
OPENAI_API_KEY=
TAVILY_API_KEY=your_tavily_api_key_here

# Outbound Email (SMTP) Configuration
# Supports standard corporate/industrial SMTP services (Office 365, Google Workspace, AWS SES)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=procurement@yourcompany.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=procurement@yourcompany.com
SMTP_TLS=true
SMTP_SSL=false

# WhatsApp Business Cloud API Configuration (Meta Graph API)
# Required only for automated direct API messaging. If unconfigured, the system
# automatically generates official wa.me draft links for manual review and sending.
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_cloud_api_access_token
WHATSAPP_API_VERSION=v19.0
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id
