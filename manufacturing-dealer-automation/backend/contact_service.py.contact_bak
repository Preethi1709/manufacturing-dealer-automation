import re
from typing import Dict, Any, Optional
from datetime import datetime, timedelta

class ContactService:
    @staticmethod
    def generate_inquiry_message(
        requirement: Dict[str, Any],
        dealer: Dict[str, Any],
        sender_name: str = "Procurement Department",
        sender_company: str = "NUnes instrumentation.",
        custom_notes: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        Generates a formal, professional Request for Quotation (RFQ) inquiry message
        tailored to specific product requirements and supplier offerings.
        Omits unknown values rather than inventing placeholders.
        """
        req_id = requirement.get("requirement_id", "REQ-N/A")
        prod_name = requirement.get("product_name") or "Industrial Part"
        category = requirement.get("category")
        specs = requirement.get("specifications")
        qty = requirement.get("quantity")
        currency = requirement.get("currency") or "USD"
        target_price = requirement.get("target_price")
        target_delivery = requirement.get("delivery_requirement")
        material = requirement.get("material")
        size = requirement.get("size")
        grade = requirement.get("grade")
        model = requirement.get("model")
        
        dealer_name = dealer.get("dealer_name") or "Supplier Representative"
        email = dealer.get("business_email")
        phone = dealer.get("public_contact_number")

        subject = f"REQUEST FOR QUOTATION: {prod_name} [Ref: {req_id}] - {sender_company}"
        
        date_str = datetime.now().strftime("%B %d, %Y")
        valid_until = (datetime.now() + timedelta(days=14)).strftime("%B %d, %Y")

        body_lines = [
            f"Date: {date_str}",
            "To: Estimating & Commercial Sales Department",
            f"Company: {dealer_name}",
            "",
            f"Dear {dealer_name} Team,",
            "",
            f"Our manufacturing engineering and procurement team at {sender_company} is currently sourcing components for upcoming production requirements. We have identified your company's product catalog and would appreciate receiving your formal Quotation / Proposal for the following items:",
            "",
            "----------------------------------------------------------------------",
            "SPECIFICATION BREAKDOWN & COMMERCIAL TERMS",
            "----------------------------------------------------------------------",
            f"Item Description      : {prod_name}"
        ]

        if category:
            body_lines.append(f"Product Category      : {category}")
        if model:
            body_lines.append(f"Model / Part Number   : {model}")
        if specs:
            body_lines.append(f"Technical Specs       : {specs}")
        if material:
            body_lines.append(f"Material Grade        : {material}")
        if size:
            body_lines.append(f"Dimensions / Size     : {size}")
        if grade:
            body_lines.append(f"Quality / Standard    : {grade}")
        if qty and qty > 0:
            body_lines.append(f"Required Volume       : {qty:,.0f} units")
        if target_price and target_price > 0:
            body_lines.append(f"Target Budget / Price : {currency} {target_price:,.2f} per unit")
        if target_delivery:
            body_lines.append(f"Required Lead Time    : {target_delivery}")

        body_lines.extend([
            "----------------------------------------------------------------------",
            "",
            "Please provide an itemized quotation including:",
            "  - Confirmed Unit Price (FOB and CIF delivery terms)",
            "  - Applicable Minimum Order Quantity (MOQ)",
            "  - Lead time from formal Purchase Order (PO) placement to dispatch",
            "  - Estimated freight / shipping charges and applicable taxes",
            "  - Material Test Report (MTR) / Certificate of Conformance availability",
            "  - Standard payment terms and quotation validity duration",
            ""
        ])

        if custom_notes and custom_notes.strip():
            body_lines.extend([
                "Special Project Instructions / Notes:",
                f"  {custom_notes.strip()}",
                ""
            ])

        body_lines.extend([
            f"We request that your proposal be submitted by {valid_until}.",
            "",
            "Should you require additional CAD drawings, 3D step files, or technical clarification, please contact our engineering team.",
            "",
            "Thank you for your prompt attention to this inquiry.",
            "",
            "Sincerely,",
            f"{sender_name}",
            f"{sender_company}",
            "Industrial Procurement & Supply Chain Operations"
        ])

        full_message = "\n".join(body_lines)

        return {
            "subject": subject,
            "message": full_message,
            "dealer_name": dealer_name,
            "business_email": email,
            "public_contact_number": phone,
            "contact_method": "Email" if email else ("WhatsApp" if phone else "Portal Inquiry")
        }

    @staticmethod
    def extract_quotation_data(reply_text: str) -> Dict[str, Any]:
        """
        Heuristically extracts quotation data (price, currency, MOQ, delivery time)
        from free-text supplier replies for review.
        Leaves unknown values as None.
        """
        if not reply_text or not isinstance(reply_text, str):
            return {
                "quoted_price": None,
                "currency": "USD",
                "moq": None,
                "delivery_time": None,
                "technical_details": None
            }

        extracted: Dict[str, Any] = {
            "quoted_price": None,
            "currency": "USD",
            "moq": None,
            "delivery_time": None,
            "technical_details": None
        }

        # 1. Price extraction
        # Look for patterns like "$45.50", "USD 120", "EUR 85.00", "Rs. 2500", "45.00 USD/unit"
        currency_match = re.search(r"(\$|€|£|₹|USD|EUR|GBP|INR)", reply_text, re.IGNORECASE)
        if currency_match:
            c = currency_match.group(1).upper()
            curr_map = {"$": "USD", "€": "EUR", "£": "GBP", "₹": "INR"}
            extracted["currency"] = curr_map.get(c, c)

        price_match = re.search(
            r"(?:price|quote|rate|unit price|cost)?\s*(?::|\s)\s*(?:\$|€|£|₹|USD|EUR|GBP|INR)?\s*([0-9]{1,6}(?:\.[0-9]{1,2})?)\s*(?:per unit|\/unit|\/pc|\/piece|usd|eur|inr)?",
            reply_text,
            re.IGNORECASE
        )
        if price_match:
            try:
                extracted["quoted_price"] = float(price_match.group(1))
            except (ValueError, IndexError):
                pass

        # 2. MOQ extraction: "MOQ: 50", "MOQ is 100 pcs", "minimum order of 25 units"
        moq_match = re.search(r"(?:moq|minimum\s+order(?:\s+quantity)?)\s*(?::|\s|is)?\s*([0-9]+)", reply_text, re.IGNORECASE)
        if moq_match:
            try:
                extracted["moq"] = float(moq_match.group(1))
            except (ValueError, IndexError):
                pass

        # 3. Delivery / Lead Time: "lead time: 2-3 weeks", "delivery within 10 days"
        lead_match = re.search(r"(?:lead\s*time|delivery\s*(?:time)?)\s*(?::|\s|is)?\s*([0-9]+\s*-\s*[0-9]+\s*(?:days?|weeks?|months?)|[0-9]+\s*(?:days?|weeks?|months?))", reply_text, re.IGNORECASE)
        if lead_match:
            extracted["delivery_time"] = lead_match.group(1).strip()

        return extracted
